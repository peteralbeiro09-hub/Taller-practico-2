# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.
# El LLM es el mismo del Taller 1: cualquier proveedor compatible con la API de OpenAI; solo cambian estas variables.

# --- Opción 1: Nemotron 3 Super 120B (NVIDIA, pesos abiertos) gratis vía OpenRouter (usada para los resultados en results/) ---
# El Taller 1 usó qwen/qwen3.8-27b:free, que OpenRouter ya no ofrece gratis; Gemma 4 (google/gemma-4-31b-it:free)
# también sirve, pero en las pruebas estuvo saturado (error 429). Ver docs/fase3_integracion.md §6.
# Clave en https://openrouter.ai/keys. Los modelos ":free" permiten 20 llamadas/min y 50/día.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-tu_clave_aqui
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_PAUSA_SEG=3.5

# --- Opción 2: Qwen 100 % local con Ollama (sin clave; ejecuta antes: ollama pull qwen2.5:7b) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
# LLM_PAUSA_SEG=0

# --- Opción 3: Groq (gratis con registro, modelos open-source) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=tu_clave_de_groq
# LLM_MODEL=llama-3.1-8b-instant

# --- Opción 4: OpenAI (de pago) ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=tu_clave_de_openai
# LLM_MODEL=gpt-4o-mini

# --- Parámetros del RAG (opcionales; estos son los valores por defecto) ---
# RAG_MODELO_EMBEDDINGS=intfloat/multilingual-e5-small
# RAG_K=4
# RAG_UMBRAL=0.80
# RAG_CHUNK_TAMANO=1000
# RAG_CHUNK_SOLAPE=80
